# Copy this file to .env and fill in the values for the API server.
# Data ingestion keys (Congress, FEC, Voyage indexing) live in pulse-ingestion.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# When MOTHERDUCK_TOKEN is set the server reads MotherDuck. Without it the server refuses to
# start querying unless ALLOW_LOCAL_DB_FALLBACK=true, which uses the local dev.duckdb.
MOTHERDUCK_DB_NAME=pulse_prod
MOTHERDUCK_TOKEN=
ALLOW_LOCAL_DB_FALLBACK=false
